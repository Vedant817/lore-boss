# Copy to .env (gitignored). Never commit values.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional; defaults to http://localhost:<PORT>/auth/callback (register exactly that URL with Twitch).
# TWITCH_REDIRECT_URI=http://localhost:3000/auth/callback
# Broadcaster user token scopes: user:read:chat user:write:chat bits:read (see ARCHITECTURE.md)
LB_SOURCE=live            # live | replay  (replay shows REPLAY badge)
LB_REPLAY_FILE=           # path to a recorded JSONL, only used with LB_SOURCE=replay
PORT=3000
DATABASE_PATH=./data/loreboss.db
MOD_TOKEN=               # generated at first boot if absent; at least 24 characters
LLM_BASE_URL=            # Groq: https://api.groq.com/openai/v1, or your Modal /v1 URL
LLM_API_KEY=             # product inference credential; blank only if local server permits it
LLM_MODEL=                # exact model id you have access to
LB_BLOCKED_WORDS=        # comma-separated terms rejected in chat/lore
